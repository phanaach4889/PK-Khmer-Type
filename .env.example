# PK Khmer Type — Supabase Cloud Sync Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
#
# IMPORTANT SECURITY NOTICE:
# Variables prefixed with VITE_ are bundled into the public frontend client.
# ONLY use your public Project URL and anon / publishable key here.
# NEVER put service_role keys, database passwords, or secret API keys in this file!

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
